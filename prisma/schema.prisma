// The Sieś Files — Prisma schema (Milestone 0 + Slice 1)
//
// This schema intentionally contains only what the current slice needs.
// Slices 2–6 will add PlayerSecret, SetupDraft, OperationalPhase, Effect,
// DeathRecord, InvestigationState, Nomination, Vote, ScenarioState, etc.
//
// Semantics are canonical (see docs/03_MVP_TECHNICAL_SPECIFICATION_v1.md §5);
// exact table/column naming may differ from the spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  LOBBY
  SETUP
  ROLE_REVEAL
  ACTIVE
  ENDED
}

enum GamePhase {
  OPERATIONAL
  INVESTIGATION
}

enum ParticipantKind {
  NORMAL
  TRAVELLER
}

enum CommandReceiptStatus {
  APPLIED
}

enum OperationalPhaseStatus {
  BUILDING
  RUNNING
  COMPLETED
}

enum OperationalActionStatus {
  PENDING
  WAITING_FOR_PLAYER
  WAITING_FOR_STORYTELLER
  RESOLVING
  RESOLVED
  SKIPPED
}

enum NominationState {
  CLOSED
  OPEN
  VOTING
  RESOLVING
}

enum NominationStatus {
  CREATED
  DAY_TRIGGER_RESOLUTION
  VOTING
  LOCKED
  RESOLVED
}

model GameSession {
  id              String        @id @default(uuid())
  name            String
  status          SessionStatus @default(LOBBY)
  phase           GamePhase?
  cycleNumber     Int           @default(0)
  version         Int           @default(0)
  eventSequence   Int           @default(0)
  scriptId        String?
  scriptVersion   Int?
  scenarioId      String?
  scenarioVersion Int?
  winner          String?
  winReason       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  players            Player[]
  events             DomainEvent[]
  commands           CommandReceipt[]
  storytellerSession BrowserSession[]
  setupDraft         SetupDraft?
  operationalPhases  OperationalPhase[]
  effects            Effect[]
  investigation      InvestigationState?
  nominations        Nomination[]
  deathRecords       DeathRecord[]
  scenario           ScenarioState?
  qrScans            QrScan[]
  scenarioDiscoveries ScenarioDiscovery[]
  taskStates         TaskState[]
  scenarioConditions ScenarioCondition[]
  checkpoints        Checkpoint[]

  @@map("game_sessions")
}

model Player {
  id                 String          @id @default(uuid())
  gameId             String
  game               GameSession     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  displayName        String
  virtualSeat        Int
  participantKind    ParticipantKind @default(NORMAL)
  alive              Boolean         @default(true)
  ghostVoteAvailable Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  claim    PlayerClaim?
  sessions BrowserSession[]
  secret   PlayerSecret?

  @@unique([gameId, virtualSeat])
  @@unique([gameId, displayName])
  @@map("players")
}

model PlayerClaim {
  id        String    @id @default(uuid())
  playerId  String    @unique
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  claimedAt DateTime?
  commandId String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("player_claims")
}

model BrowserSession {
  id                String       @id @default(uuid())
  playerId          String?
  player            Player?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  storytellerGameId String?
  storytellerGame   GameSession? @relation(fields: [storytellerGameId], references: [id], onDelete: Cascade)
  sessionTokenHash  String       @unique
  createdAt         DateTime     @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([playerId])
  @@index([storytellerGameId])
  @@map("browser_sessions")
}

model DomainEvent {
  id          String      @id @default(uuid())
  gameId      String
  game        GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sequence    Int
  gameVersion Int
  eventType   String
  actor       String?
  commandId   String?
  payload     Json?
  createdAt   DateTime    @default(now())

  @@unique([gameId, sequence])
  @@index([gameId, createdAt])
  @@index([commandId])
  @@map("domain_events")
}

model CommandReceipt {
  id               String      @id @default(uuid())
  commandId        String
  gameId           String
  game             GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  resultingVersion Int
  status           CommandReceiptStatus @default(APPLIED)
  resultJson       Json?
  createdAt        DateTime    @default(now())

  @@unique([gameId, commandId])
  @@map("command_receipts")
}

model PlayerSecret {
  playerId             String    @id
  player               Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  trueCharacterId      String?
  perceivedCharacterId String?
  trueAlignment        String?
  abilityStateJson     Json?
  roleAcknowledgedAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("player_secrets")
}

model SetupDraft {
  id                String      @id @default(uuid())
  gameId            String      @unique
  game              GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  generatorVersion  Int
  seed              String
  candidateJson     Json
  regenerationIndex Int         @default(0)
  committedAt       DateTime?
  setupHash         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("setup_drafts")
}

model OperationalPhase {
  id          String                 @id @default(uuid())
  gameId      String
  game        GameSession            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cycleNumber Int
  status      OperationalPhaseStatus @default(RUNNING)
  startedAt   DateTime               @default(now())
  completedAt DateTime?

  actions OperationalAction[]

  @@index([gameId, cycleNumber])
  @@map("operational_phases")
}

model OperationalAction {
  id                 String                  @id @default(uuid())
  operationalPhaseId String
  phase              OperationalPhase        @relation(fields: [operationalPhaseId], references: [id], onDelete: Cascade)
  orderIndex         Int
  kind               String
  actorPlayerId      String?
  status             OperationalActionStatus @default(PENDING)
  publicJson         Json?
  secretJson         Json?
  resolutionJson     Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([operationalPhaseId, orderIndex])
  @@map("operational_actions")
}

model Effect {
  id             String      @id @default(uuid())
  gameId         String
  game           GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  effectType     String
  sourcePlayerId String?
  targetPlayerId String
  cycleNumber    Int
  expiryBoundary String
  active         Boolean     @default(true)
  metadataJson   Json?
  createdAt      DateTime    @default(now())

  @@index([gameId, active])
  @@index([targetPlayerId, active])
  @@map("effects")
}

model InvestigationState {
  gameId                            String          @id
  game                              GameSession     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cycleNumber                       Int
  nominationState                   NominationState @default(CLOSED)
  currentExecutionCandidatePlayerId String?
  currentHighEffectiveVotes         Int?
  executionOccurred                 Boolean         @default(false)
  startedAt                         DateTime        @default(now())
  completedAt                       DateTime?

  @@map("investigation_states")
}

model Nomination {
  id             String          @id @default(uuid())
  gameId         String
  game           GameSession     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cycleNumber    Int
  nominatorId    String
  nomineeId      String
  status         NominationStatus @default(CREATED)
  sequence       Int
  rawTotal       Int             @default(0)
  effectiveTotal Int             @default(0)
  qualified      Boolean         @default(false)
  decisionJson   Json?
  passStatus     String          @default("READY")
  currentVirtualSeat Int?
  createdAt      DateTime        @default(now())

  votes Vote[]

  @@unique([gameId, cycleNumber, sequence])
  @@map("nominations")
}

model Vote {
  id                String    @id @default(uuid())
  nominationId      String
  nomination        Nomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  playerId          String
  rawIntent         Boolean   @default(false)
  valid             Boolean   @default(false)
  effectiveWeight   Int       @default(0)
  ghostVoteConsumed Boolean   @default(false)
  invalidReason     String?
  lockedAt          DateTime?

  @@unique([nominationId, playerId])
  @@map("votes")
}

model DeathRecord {
  id              String      @id @default(uuid())
  gameId          String
  game            GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId        String
  cycleNumber     Int
  phase           String
  source          String
  causedByPlayerId String?
  executed        Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@index([gameId, playerId])
  @@map("death_records")
}

model ScenarioState {
  gameId          String      @id
  game            GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  scenarioId      String?
  scenarioVersion Int?
  stageId         String?
  mapVersionId    String?
  stateJson       Json?
  updatedAt       DateTime    @updatedAt

  @@map("scenario_states")
}

model QrScan {
  id        String   @id @default(uuid())
  gameId    String
  game      GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  qrTokenId String
  commandId String
  outcome   String   @default("CONSUMED")
  createdAt DateTime @default(now())

  @@unique([gameId, playerId, commandId])
  @@index([gameId, playerId])
  @@map("qr_scans")
}

model ScenarioDiscovery {
  id              String   @id @default(uuid())
  gameId          String
  game            GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId        String?
  objectId        String
  objectType      String
  visibilityScope String
  contentJson     Json?
  discoveredAt    DateTime @default(now())

  @@index([gameId, playerId])
  @@map("scenario_discoveries")
}

model TaskState {
  id        String   @id @default(uuid())
  gameId    String
  game      GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  taskId    String
  playerId  String?
  state     String   @default("AVAILABLE")
  updatedAt DateTime @updatedAt

  @@index([gameId, taskId])
  @@map("task_states")
}

model ScenarioCondition {
  id          String   @id @default(uuid())
  gameId      String
  game        GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  conditionId String
  playerId    String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([gameId, conditionId])
  @@map("scenario_conditions")
}

model Checkpoint {
  id                String      @id @default(uuid())
  gameId            String
  game              GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameVersion       Int
  lastEventSequence Int
  snapshotJson      Json
  checksum          String
  reason            String?
  boundaryKey       String?
  createdAt         DateTime    @default(now())

  @@index([gameId, createdAt])
  @@unique([gameId, boundaryKey])
  @@map("checkpoints")
}

model Presence {
  id        String    @id @default(uuid())
  gameId    String
  viewerId  String
  lastSeenAt DateTime @default(now())

  @@unique([gameId, viewerId])
  @@index([gameId, lastSeenAt])
  @@map("presence")
}
